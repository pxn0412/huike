# Copy this file to .env and fill in the credentials from your own model console.
# This optional model adapter is NOT an integration of an ADP canvas workflow.
# Any OpenAI-compatible endpoint works; the defaults below point at DeepSeek.
# Official API reference: https://api-docs.deepseek.com/
HUIKE_AI_BASE_URL=https://api.deepseek.com/v1
HUIKE_AI_MODEL=deepseek-chat
HUIKE_AI_KEY=sk-replace-with-your-own-key

# 文件图片识别专用模型，不改变上面的问答模型。
# 官方 DeepSeek 地址默认使用 deepseek-flash；其他兼容服务必须显式配置视觉模型。
# 设为空可关闭视觉模型并恢复本地 OCR 路径。
HUIKE_DOCUMENT_MODEL=deepseek-flash

# Optional: upload the chunked text into a Tencent Cloud ADP knowledge base.
# Used by website/adp.py (SaveDoc: DescribeStorageCredential -> COS PUT -> SaveDoc).
# Keep these keys out of git; only needed when you actually run the upload step.
TENCENT_SECRET_ID=replace-with-your-tencent-cloud-secret-id
TENCENT_SECRET_KEY=replace-with-your-tencent-cloud-secret-key
ADP_KB_ID=replace-with-your-knowledge-base-id
ADP_REGION=ap-guangzhou
# 网站里"确认添加"后自动把资料送进知识库；填 0 可关掉（默认开）
ADP_AUTO_UPLOAD=1

# Optional: run the evaluation set against the published app (website/eval_adp.py).
# AppKey: 应用管理 → 应用 → 调用（HTTP SSE 只需要 AppKey）。
ADP_APP_KEY=replace-with-your-app-key
ADP_CHAT_URL=https://wss.lke.cloud.tencent.com/adp/v2/chat

# Optional: the second app — "学生画像助手"（学生画像 / 组队招募）。
# 它不读比赛知识库，只依据学生自述整理画像；不配这一项，网站里的"我的画像"页会提示未配置。
ADP_PROFILE_APP_KEY=replace-with-your-profile-app-key
ADP_PROFILE_CHAT_URL=https://wss.lke.cloud.tencent.com/adp/v2/chat
